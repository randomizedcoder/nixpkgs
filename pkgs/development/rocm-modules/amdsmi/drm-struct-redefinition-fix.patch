From b8b4a6bcfe35ba9539a120cfd16573123ddd9241 Mon Sep 17 00:00:00 2001
From: "Sv. Lockal" <lockalsash@gmail.com>
Date: Mon, 15 Dec 2025 03:46:35 +0800
Subject: [PATCH] Fix compilation with recent libdrm

Fix error: redefinition of 'struct drm_color_ctm_3x4'.

drm_color_ctm_3x4 structure is now defined in https://github.com/torvalds/linux/commit/e5719e7f19009d4fbedf685fc22eec9cd8de154f

As this structure is unused and not a part of amdsmi public interface,
it is safe to remove it.

ROCm 10 moved the bundled drm headers from
include/amd_smi/impl/amdgpu_drm.h to include/libdrm/, and the struct now
lives in include/libdrm/drm_mode.h. Rebased accordingly.
---
 include/libdrm/drm_mode.h | 14 --------------
 1 file changed, 14 deletions(-)
--- a/include/libdrm/drm_mode.h
+++ b/include/libdrm/drm_mode.h
@@ -825,20 +825,6 @@
   __u64 matrix[9];
 };
 
-struct drm_color_ctm_3x4 {
-  /*
-   * Conversion matrix with 3x4 dimensions in S31.32 sign-magnitude
-   * (not two's complement!) format.
-   *
-   * out   matrix          in
-   * |R|   |0  1  2  3 |   | R |
-   * |G| = |4  5  6  7 | x | G |
-   * |B|   |8  9  10 11|   | B |
-   *                       |1.0|
-   */
-  __u64 matrix[12];
-};
-
 struct drm_color_lut {
   /*
    * Values are mapped linearly to 0.0 - 1.0 range, with 0x0 == 0.0 and
