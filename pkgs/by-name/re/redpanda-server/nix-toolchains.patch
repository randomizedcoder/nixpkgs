+# gazelle's go_deps normally fetches Go modules with `fetch_repo`, which talks
+# GOPROXY directly and bypasses Bazel's repository cache, so the modules are
+# not in the fixed-output cache and the offline build fails. An
+# archive_override makes go_repository use Bazel's own downloader instead, so
+# the proxy zips are cached like every other archive. Only the two modules
+# that //bazel/pbgen and rules_go's proto support need are built.
+go_deps.archive_override(
+    path = "google.golang.org/protobuf",
+    sha256 = "68f8a3174aff42950fd9bd02c11b45c6986eb8060508d124d1c3dd6bf86b9be6",
+    strip_prefix = "google.golang.org/protobuf@v1.36.12",
+    urls = ["https://proxy.golang.org/google.golang.org/protobuf/@v/v1.36.12.zip"],
+)
+go_deps.archive_override(
+    path = "github.com/golang/protobuf",
+    sha256 = "9a2f43d3eac8ceda506ebbeb4f229254b87235ce90346692a0e233614182190b",
+    strip_prefix = "github.com/golang/protobuf@v1.5.4",
