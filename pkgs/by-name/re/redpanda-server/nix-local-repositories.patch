--- a/bazel/thirdparty/c-ares-nix.BUILD
+++ b/bazel/thirdparty/c-ares-nix.BUILD
@@ -0,0 +1,15 @@
+load("@rules_cc//cc:cc_import.bzl", "cc_import")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+cc_import(
+    name = "cares_lib",
+    shared_library = "lib/libcares.so.2",
+)
+
+cc_library(
+    name = "c-ares",
+    hdrs = glob(["include/*.h"]),
+    includes = ["include"],
+    visibility = ["//visibility:public"],
+    deps = [":cares_lib"],
+)
--- a/bazel/thirdparty/krb5-nix.BUILD
+++ b/bazel/thirdparty/krb5-nix.BUILD
@@ -0,0 +1,30 @@
+load("@rules_cc//cc:cc_import.bzl", "cc_import")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+[
+    cc_import(
+        name = name + "_lib",
+        shared_library = "lib/lib{}.so.{}".format(name, sover),
+    )
+    for name, sover in [
+        ("com_err", "3"),
+        ("gssapi_krb5", "2"),
+        ("k5crypto", "3"),
+        ("krb5", "3"),
+        ("krb5support", "0"),
+    ]
+]
+
+cc_library(
+    name = "krb5",
+    hdrs = glob(["include/**/*.h"]),
+    includes = ["include"],
+    visibility = ["//visibility:public"],
+    deps = [
+        ":com_err_lib",
+        ":gssapi_krb5_lib",
+        ":k5crypto_lib",
+        ":krb5_lib",
+        ":krb5support_lib",
+    ],
+)
--- a/bazel/thirdparty/openssl-nix.BUILD
+++ b/bazel/thirdparty/openssl-nix.BUILD
@@ -0,0 +1,78 @@
+load("@bazel_skylib//rules:common_settings.bzl", "int_flag", "string_flag")
+load("@rules_cc//cc:cc_import.bzl", "cc_import")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+# Settings referenced by openssl-fips.BUILD.
+int_flag(
+    name = "build_jobs",
+    build_setting_default = 8,
+    make_variable = "BUILD_JOBS",
+    visibility = ["@openssl-fips//:__pkg__"],
+)
+
+string_flag(
+    name = "build_mode",
+    build_setting_default = "default",
+    values = [
+        "debug",
+        "release",
+        "default",
+    ],
+)
+
+config_setting(
+    name = "debug_mode",
+    flag_values = {":build_mode": "debug"},
+)
+
+config_setting(
+    name = "release_mode",
+    flag_values = {":build_mode": "release"},
+)
+
+cc_import(
+    name = "ssl_lib",
+    shared_library = "lib/libssl.so.3",
+)
+
+cc_import(
+    name = "crypto_lib",
+    shared_library = "lib/libcrypto.so.3",
+)
+
+cc_library(
+    name = "openssl_foreign_cc",
+    hdrs = glob(["include/openssl/*.h"]),
+    includes = ["include"],
+    visibility = ["//visibility:public"],
+    deps = [
+        ":crypto_lib",
+        ":ssl_lib",
+    ],
+)
+
+cc_library(
+    name = "openssl",
+    visibility = ["//visibility:public"],
+    deps = [":openssl_foreign_cc"],
+)
+
+exports_files(["bin/openssl"])
+
+filegroup(
+    name = "openssl_binary",
+    srcs = ["bin/openssl"],
+    visibility = ["//visibility:public"],
+)
+
+filegroup(
+    name = "openssl_exe",
+    srcs = ["bin/openssl"],
+    visibility = ["//visibility:public"],
+)
+
+filegroup(
+    name = "openssl_data",
+    srcs = glob(["etc/ssl/**"]),
+    visibility = ["//visibility:public"],
+)
--- a/bazel/thirdparty/wasmtime-nix.BUILD
+++ b/bazel/thirdparty/wasmtime-nix.BUILD
@@ -0,0 +1,24 @@
+load("@rules_cc//cc:cc_import.bzl", "cc_import")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+# Prebuilt wasmtime C API (see wasmtime-c-api.nix in the nixpkgs package).
+cc_import(
+    name = "libwasmtime",
+    static_library = "lib/libwasmtime.a",
+)
+
+cc_library(
+    name = "wasmtime_c",
+    hdrs = glob([
+        "include/**/*.h",
+        "include/**/*.hh",
+    ]),
+    linkopts = [
+        "-lm",
+        "-lpthread",
+        "-ldl",
+    ],
+    strip_include_prefix = "include",
+    visibility = ["//visibility:public"],
+    deps = [":libwasmtime"],
+)
